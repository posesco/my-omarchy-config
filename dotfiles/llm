#!/bin/bash

# Configuration file
CONFIG_FILE="$HOME/.config/llama-server.conf"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Configuration file not found at $CONFIG_FILE" >&2
    exit 1
fi

# Load configuration
source "$CONFIG_FILE"

# Resolve model path (supports ~ and environment variables)
RESOLVED_MODEL_PATH=$(eval echo "$MODEL_PATH")

if [ ! -f "$RESOLVED_MODEL_PATH" ]; then
    echo "Error: Model file does not exist at: $RESOLVED_MODEL_PATH" >&2
    echo "Please verify the path in $CONFIG_FILE" >&2
    exit 1
fi

echo "Starting Llama.cpp with configuration from: $CONFIG_FILE"
echo "Model: $RESOLVED_MODEL_PATH"
echo "Port: $PORT | Threads: $THREADS | GPU Layers: $GPU_LAYERS | Context: $CTX_SIZE"
echo "--------------------------------------------------"

# Run the server with optimized parameters
exec llama-server \
    -m "$RESOLVED_MODEL_PATH" \
    --port "$PORT" \
    -t "$THREADS" \
    -ngl "$GPU_LAYERS" \
    -c "$CTX_SIZE" \
    --flash-attn on \
    --host 127.0.0.1 \
    "$@"
