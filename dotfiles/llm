#!/bin/bash

# Archivo de configuración
CONFIG_FILE="$HOME/.config/llama-server.conf"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: No se encontró el archivo de configuración en $CONFIG_FILE" >&2
    exit 1
fi

# Cargar la configuración
source "$CONFIG_FILE"

# Resolver la ruta del modelo (por si tiene ~ o variables de entorno)
RESOLVED_MODEL_PATH=$(eval echo "$MODEL_PATH")

if [ ! -f "$RESOLVED_MODEL_PATH" ]; then
    echo "Error: El archivo de modelo no existe en: $RESOLVED_MODEL_PATH" >&2
    echo "Por favor, verificá la ruta en $CONFIG_FILE" >&2
    exit 1
fi

echo "Iniciando Llama.cpp con la configuración de: $CONFIG_FILE"
echo "Modelo: $RESOLVED_MODEL_PATH"
echo "Puerto: $PORT | Hilos: $THREADS | GPU Layers: $GPU_LAYERS | Contexto: $CTX_SIZE"
echo "--------------------------------------------------"

# Sincronizar automáticamente el modelo por defecto en Fabric
FABRIC_ENV="$HOME/.config/fabric/.env"
if [ -f "$FABRIC_ENV" ]; then
    MODEL_NAME=$(basename "$RESOLVED_MODEL_PATH")
    if grep -q "^DEFAULT_MODEL=" "$FABRIC_ENV"; then
        sed -i "s/^DEFAULT_MODEL=.*/DEFAULT_MODEL=$MODEL_NAME/" "$FABRIC_ENV"
        echo "Fabric sincronizado: modelo por defecto actualizado a '$MODEL_NAME'"
    fi
fi

# Ejecutar el servidor con los parámetros optimizados
exec llama-server \
    -m "$RESOLVED_MODEL_PATH" \
    --port "$PORT" \
    -t "$THREADS" \
    -ngl "$GPU_LAYERS" \
    -c "$CTX_SIZE" \
    --flash-attn on \
    --host 127.0.0.1 \
    "$@"
