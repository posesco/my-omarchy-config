# Terraform workflows
alias tpre='echo -e "Preparing to deploy the Terraform project\n" && terraform workspace select dev && echo -e "Workspace: $(terraform workspace show)\n" && terraform fmt && terraform validate && terraform plan && tfsec'
alias gtpre='echo -e "Preparing to deploy the Terraform Global project\n" && terraform fmt && terraform validate && terraform plan && tfsec'
