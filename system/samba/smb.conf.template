[global]
   workgroup = WORKGROUP
   server string = Samba Server
   security = user
   server min protocol = SMB2_02
   dns proxy = no
   map to guest = Never
   restrict anonymous = 2
   hosts allow = 192.168.1.0/24
   hosts deny = ALL

[pandastic]
   comment = Pandastic shared directory
   path = /srv/pandastic
   browsable = yes
   read only = no
   guest ok = no
   valid users = mordecai
   force user = mordecai
   create mask = 0660
   force create mode = 0660
   directory mask = 0770
   force directory mode = 0770

   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   fruit:encoding = native
